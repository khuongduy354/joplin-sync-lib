# Joplin Sync Library - Environment Variables Template
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to version control

# ============================================
# OneDrive OAuth Credentials
# ============================================
# How to obtain:
# 1. Go to https://portal.azure.com
# 2. Register a new application
# 3. Add API permissions: Files.ReadWrite.AppFolder, offline_access
# 4. Create client secret
# 5. Use OAuth flow to get auth token (see docs/AUTHENTICATION.md)

ONEDRIVE_CLIENT_ID=your_azure_app_client_id
ONEDRIVE_CLIENT_SECRET=your_azure_app_client_secret
# Auth token must be valid JSON with access_token and refresh_token
ONEDRIVE_AUTH_TOKEN={"access_token":"your_access_token","refresh_token":"your_refresh_token","token_type":"Bearer","expires_in":3600}

# ============================================
# Google Drive OAuth Credentials
# ============================================
# How to obtain:
# 1. Go to https://console.cloud.google.com
# 2. Create a new project
# 3. Enable Google Drive API
# 4. Create OAuth 2.0 credentials
# 5. Add scope: https://www.googleapis.com/auth/drive.appdata
# 6. Use OAuth flow to get auth token (see docs/AUTHENTICATION.md)

GOOGLEDRIVE_CLIENT_ID=your_google_client_id
GOOGLEDRIVE_CLIENT_SECRET=your_google_client_secret
# Auth token must be valid JSON with access_token and refresh_token
GOOGLEDRIVE_AUTH_TOKEN={"access_token":"your_access_token","refresh_token":"your_refresh_token","token_type":"Bearer","expires_in":3600}

# ============================================
# Joplin Server (for testing)
# ============================================
JOPLIN_SERVER_URL=http://localhost:22300
JOPLIN_SERVER_USERNAME=admin@localhost
JOPLIN_SERVER_PASSWORD=admin

# ============================================
# WebDAV (for testing)
# ============================================
WEBDAV_URL=http://localhost:8080
WEBDAV_USERNAME=joplin
WEBDAV_PASSWORD=joplin

# ============================================
# Testing Configuration
# ============================================
# Set to 'true' to skip tests requiring cloud credentials
SKIP_CLOUD_TESTS=false

# Default sync target for tests (1=Memory, 2=FileSystem, 3=OneDrive, 9=JoplinServer)
TEST_SYNC_TARGET=1
